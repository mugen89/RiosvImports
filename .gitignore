# Сглобки
bin/
obj/
.vs/
.idea/
*.user
*.suo
*.DotSettings.user
publish/
TestResults/

# Пакетите за раздаване се правят наново при нужда (над 100 MB).
dist/
*.zip

# Изданията се правят наново от tools\release.ps1.
artifacts/
Releases/

# Частният ключ за правото на ползване и ключовете за GitHub никога не влизат тук.
*.pem
*.pfx
*.p12
*.key
.env

# Местна база с работата на потребителя, ако някой я копира тук.
*.db
*.db-wal
*.db-shm

# Excel файлове от ръчно пробване. Шаблон в документацията се пуска нарочно.
*.xlsx
!docs/**/*.xlsx

# Дневници
*.log
