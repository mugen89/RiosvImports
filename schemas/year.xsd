<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:tns="http://niso.tlogica.com/year.xsd"
           xmlns:dsig="http://www.w3.org/2000/09/xmldsig#"
           xmlns:cm="http://niso.tlogica.com/common-types.xsd"
           xmlns:ewc="http://niso.tlogica.com/ewc.xsd"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://niso.tlogica.com/year.xsd"
           elementFormDefault="qualified">
    <xs:import namespace="http://www.w3.org/2000/09/xmldsig#"
               schemaLocation="xmldsig-core-schema.xsd"/>
    <xs:import namespace="http://niso.tlogica.com/common-types.xsd" schemaLocation="common-types.xsd"/>
    <xs:import namespace="http://niso.tlogica.com/ewc.xsd" schemaLocation="ewc.xsd"/>
    <xs:element name="reports">
        <xs:complexType>
            <xs:sequence>
                <!-- Годишен отчет за събиране и съхраняване на черни и цветни метали -->
                <xs:element name="r_yr_cs_bcmetal"
                            type="tns:r_yr_cs_bcmetalType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за образувани производствени или опасни отпадъци (Приложение 9) -->
                <xs:element name="r_yr_generated_waste"
                            type="tns:r_yr_generated_wasteType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за събиране и транспортиране на производствени и/или опасни отпадъци (Приложение №10) и Годишен отчет за събиране и транспортиране на отпадъци от черни и цветни метали (Приложение №17) -->
                <xs:element name="r_yr_r10"
                            type="tns:r_yr_r10Type"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за събиране и транспортиране на битови и/или строителни отпадъци. (Приложение № 11) -->
                <xs:element name="r_yr_ct_bc_waste"
                            type="tns:r_yr_ct_bc_wasteType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за събиране и съхраняване на производствени и/или опаси отпадъци. (Приложение № 12) -->
                <xs:element name="r_yr_collection_storage"
                            type="tns:r_yr_collection_storageType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за събиране и съхраняване на негодни за употреба батерии и акумулатори (Приложение 13) -->
                <xs:element name="r_yr_cs_nuba"
                            type="tns:r_yr_cs_nubaType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за събиране и съхраняване на негодни за употреба електрическо и електронно оборудване (Приложение 14) -->
                <xs:element name="r_yr_cs_iueeo"
                            type="tns:r_yr_cs_iueeoType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за събиране и съхраняване на излезли от употреба моторни превозни средства (Приложение 15) -->
                <xs:element name="r_yr_cs_iumps"
                            type="tns:r_yr_cs_iumpsType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за събиране и съхраняване отработени масла (Приложение 16) -->
                <xs:element name="r_yr_cs_oil"
                            type="tns:r_yr_cs_oilType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за оползотворяване на опаковки. (Приложение № 19а – 19е) -->
                <xs:element name="r_yr_disposal_package"
                            type="tns:r_yr_disposal_packageType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за подготовка преди оползотворяване или обезвреждане на отпадъци с произход от бита (Приложение № 20) -->
                <xs:element name="r_yr_prep_household"
                            type="tns:r_yr_prep_householdType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за образуни утайки от ПСОВ (Приложение 21) -->
                <xs:element name="r_yr_wwtp"
                            type="tns:r_yr_wwtpType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за депониране на отпадъци (Приложение 31) -->
                <xs:element name="r_yr_depot"
                            type="tns:r_yr_depotType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за оползотворяване/обезвреждане на производствени и/или опасни отпадъци, Приложение 18 -->
                <xs:element name="r_yr_recovery_disposal"
                            type="tns:r_yr_recovery_disposalType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за оползотворяване/обезвреждане на излязло от употреба електрическо и електронно оборудване (ИУЕЕО), Приложение 22 -->
                <xs:element name="r_yr_rd_iueeo"
                            type="tns:r_yr_rd_iueeoType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за оползотворяване/обезвреждане на излезли от употреба моторни превозни средства (ИУМПС), Приложение 23 -->
                <xs:element name="r_yr_rd_iumps"
                            type="tns:r_yr_rd_iumpsType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за оползотворяване/обезвреждане на отработени масла (ОМ), Приложение 24 -->
                <xs:element name="r_yr_rd_oil"
                            type="tns:r_yr_rd_oilType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за оползотворяване/обезвреждане на излезли от употреба гуми (ИУГ) Приложение 25 -->
                <xs:element name="r_yr_rd_tires"
                            type="tns:r_yr_rd_tiresType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за рециклиране на негодни за употреба батерии и акумулатори (НУБА), Приложение 26 -->
                <xs:element name="r_yr_rd_nuba"
                            type="tns:r_yr_rd_nubaType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за подготовка преди оползотворяване или обезвреждане на строителни отпадъци, както и за произведени рециклирани строителни материали (Приложение № 28) -->
                <xs:element name="r_yr_rdcm"
                            type="tns:r_yr_rdcmType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за вложените рециклирани строителни материали от оползотворени строителни отпадъци (Приложение № 29) -->
                <xs:element name="r_yr_rcmrcm"
                            type="tns:r_yr_rcmrcmType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за оползотворени строителни отпадъци в обратни насипи (Приложение № 30) -->
                <xs:element name="r_yr_rcmwre"
                            type="tns:r_yr_rcmwreType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за компостиране, анаеробно разграждане и механично-биологично третиране (МБТ) на биоотпадъци (Приложение № 33) -->
                <xs:element name="r_yr_camt"
                            type="tns:r_yr_camtType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за търговец или брокер (Приложение № 34) -->
                <xs:element name="r_yr_traders"
                            type="tns:r_yr_tradersType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет за дейностите с отпадъци по регламент на ЕО отностно превоза на отпадъци (Приложение № 35) -->
                <xs:element name="r_yr_eu"
                            type="tns:r_yr_euType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишна справка декларация за дейностите с отпадъци по регламент на ЕО отностно превоза на отпадъци (Приложение № 36) -->
                <xs:element name="r_yr_eu_decl"
                            type="tns:r_yr_eu_declType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет на регионалните сдружения на общините (Приложение № 32) -->
                <xs:element name="r_yr_municipality_ass"
                            type="tns:r_yr_municipality_assType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- Годишен отчет по чл.12 от регламент (ЕС) 2017/852 -->
                <xs:element name="r_yr_merc"
                            type="tns:r_yr_mercType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <xs:element name="r_yr_man"
                            type="tns:r_yr_manType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <xs:element name="r_yr_inc"
                            type="tns:r_yr_incType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>
                <!-- КЕП -->
                <xs:element minOccurs="1"
                            maxOccurs="1"
                            ref="dsig:Signature"/>
            </xs:sequence>
            <xs:attribute name="year"
                          type="cm:yearType"
                          use="required"/>
            <xs:attribute name="eik"
                          type="cm:EikType"
                          use="required"/>
            <xs:attribute name="type"
                          type="cm:ImportType"
                          use="required"/>
        </xs:complexType>
    </xs:element>
    <!-- Годишен отчет за събиране и съхраняване на черни и цветни метали -->
    <xs:complexType name="r_yr_cs_bcmetalType">
        <xs:sequence minOccurs="1"
                     maxOccurs="1">
            <xs:element name="r_yr_cs_bcmetal_indata"
                        minOccurs="0"
                        maxOccurs="1">
                <xs:complexType>
                    <xs:sequence minOccurs="1"
                                 maxOccurs="1">
                        <xs:element name="item"
                                    type="tns:r_yr_cs_bcmetal_indataType"
                                    minOccurs="1"
                                    maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="r_yr_cs_bcmetal_outdata"
                        minOccurs="0"
                        maxOccurs="1">
                <xs:complexType>
                    <xs:sequence minOccurs="1"
                                 maxOccurs="1">
                        <xs:element name="item"
                                    type="tns:r_yr_cs_bcmetal_outdataType"
                                    minOccurs="1"
                                    maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="r_yr_cs_bcmetal_qdata"
                        minOccurs="0"
                        maxOccurs="1">
                <xs:complexType>
                    <xs:sequence minOccurs="1"
                                 maxOccurs="1">
                        <xs:element name="item"
                                    type="tns:r_yr_cs_bcmetal_qdataType"
                                    minOccurs="1"
                                    maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>

        <!-- Номер на площадката -->
        <xs:attribute name="stagenum"
                      type="cm:stagenumType"
                      use="required"/>
        <!-- Други бележки -->
        <xs:attribute name="other_notes"
                      type="cm:stringLength1024"/>
    </xs:complexType>
    <!-- Списък на лицата, от които са приети отпадъците -->
    <xs:complexType name="r_yr_cs_bcmetal_indataType">
        <!-- Код на отпадъка -->
        <xs:attribute name="ewc"
                      type="ewc:ewcCodeType"
                      use="required"></xs:attribute>
        <!-- Тип -->
        <xs:attribute name="type_receiver_code"
                      type="cm:PersonType"
                      use="required"></xs:attribute>
        <!-- Име -->
        <xs:attribute name="name"
                      type="cm:stringLength500"
                      use="required"></xs:attribute>
        <!-- ЕИК -->
        <xs:attribute name="pin"
                      type="cm:stringLength500"></xs:attribute>
        <!-- Основание за притежание -->
        <xs:attribute name="doc_num_grounds"
                      type="cm:stringLength500"></xs:attribute>
        <!-- Произход -->
        <xs:attribute name="origin"
                      type="cm:ReasonOriginType"></xs:attribute>
        <!-- Количество тон -->
        <xs:attribute name="amount_ton"
                      type="cm:amountDeciGramNonNegative"
                      use="required"></xs:attribute>
    </xs:complexType>
    <!-- Списък на лицата, на които са предадени отпадъците -->
    <xs:complexType name="r_yr_cs_bcmetal_outdataType">
        <!-- Код на отпадъка -->
        <xs:attribute name="ewc"
                      type="ewc:ewcCodeType"
                      use="required"></xs:attribute>
        <!-- Тип на получателя -->
        <xs:attribute name="type_receiver_code"
                      type="cm:PersonType"
                      use="required"></xs:attribute>
        <!-- Име на получателя -->
        <xs:attribute name="receiver_name"
                      type="cm:stringLength500"
                      use="required"></xs:attribute>
        <!-- ЕИК -->
        <xs:attribute name="receiver_pin_name"
                      type="cm:stringLength500"></xs:attribute>
        <!-- Основание за притежание -->
        <xs:attribute name="doc_num_grounds"
                      type="cm:stringLength500"></xs:attribute>
        <!-- Количество тон -->
        <xs:attribute name="amount_ton"
                      type="cm:amountDeciGramNonNegative"
                      use="required"></xs:attribute>
    </xs:complexType>
    <!-- Количествени данни -->
    <xs:complexType name="r_yr_cs_bcmetal_qdataType">
        <!-- Код на отпадъка -->
        <xs:attribute name="ewc"
                      type="ewc:ewcCodeType"
                      use="required"></xs:attribute>
        <!-- Налични към 1 януари на отчетната година -->
        <xs:attribute name="aton_beg"
                      type="cm:amountNonNegative"></xs:attribute>
        <!-- Приети -->
        <xs:attribute name="aton_in_total"
                      type="cm:amountNonNegative"></xs:attribute>
        <!-- Предадени -->
        <xs:attribute name="aton_out_total"
                      type="cm:amountNonNegative"></xs:attribute>
        <!-- Налични към 31 декември на отчетната година -->
        <xs:attribute name="aton_end"
                      type="cm:amountNonNegative"></xs:attribute>
    </xs:complexType>
    <!-- Годишен отчет за образувани производствени или опасни отпадъци (Приложение 9) -->
    <xs:complexType name="r_yr_generated_wasteType">
        <xs:sequence minOccurs="1"
                     maxOccurs="1">
            <xs:element name="r_yr_generated_waste_amt"
                        minOccurs="0"
                        maxOccurs="1">
                <xs:complexType>
                    <xs:sequence minOccurs="1"
                                 maxOccurs="1">
                        <xs:element name="item"
                                    type="tns:r_yr_generated_waste_amtType"
                                    minOccurs="1"
                                    maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="r_yr_generated_waste_hand"
                        minOccurs="0"
                        maxOccurs="1">
                <xs:complexType>
                    <xs:sequence minOccurs="1"
                                 maxOccurs="1">
                        <xs:element name="item"
                                    type="tns:r_yr_generated_waste_handType"
                                    minOccurs="1"
                                    maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        <!-- ID на работен лист -->
        <xs:attribute name="stagenum"
                      type="cm:stagenumType"
                      use="required"/>
        <!-- Произход -->
        <xs:attribute name="origin"
                      type="cm:stringLength256"
                      use="required"/>
        <!-- Базелска конвенция -->
        <xs:attribute name="id_basel"
                      type="cm:baselConvention"/>
        <!-- Код съгласно Базелската конвенция -->
        <xs:attribute name="id_basel_code"
                      type="cm:baselConventionCode"/>
        <!-- Свойства, които определят отпадъка като опасен -->
        <xs:attribute name="basel_danger_h1"
                      type="cm:baselConventionDanger"/>
        <!-- Свойства, които определят отпадъка като опасен -->
        <xs:attribute name="basel_danger_h2"
                      type="cm:baselConventionDanger"/>
        <!-- Свойства, които определят отпадъка като опасен -->
        <xs:attribute name="basel_danger_h3"
                      type="cm:baselConventionDanger"/>
        <!-- Свойства, които определят отпадъка като опасен -->
        <xs:attribute name="basel_danger_h4"
                      type="cm:baselConventionDanger"/>
        <!-- Други бележки -->
        <xs:attribute name="other_notes"
                      type="cm:stringLength1024"/>
    </xs:complexType>
    <!-- Годишен отчет за образувани производствени или опасни отпадъци (Приложение 9) – Таблица „Количества отпадък“ -->
    <xs:complexType name="r_yr_generated_waste_amtType">
        <!-- Наличен отпадък към 1 януари на отчетната година -->
        <xs:attribute name="amount_ton_beg"
                      type="cm:amountDeciGramNonNegative"/>
        <!-- Образуван отпадък -->
        <xs:attribute name="amount_ton_gen"
                      type="cm:amountDeciGramNonNegative"/>
        <!-- Третиран отпадък -->
        <xs:attribute name="amount_ton_treated"
                      type="cm:amountDeciGramNonNegative"/>
        <!-- Предаден отпадък -->
        <xs:attribute name="amount_ton_handed"
                      type="cm:amountDeciGramNonNegative"/>
        <!-- Наличен към 31 декември на отчетната година -->
        <xs:attribute name="amount_ton_end"
                      type="cm:amountDeciGramNonNegative"/>
        <!-- Описание на третирането -->
        <xs:attribute name="treat_desc"
                      type="cm:stringLength512"/>
        <!-- Срок на съхранение -->
        <xs:attribute name="storage_period"
                      type="cm:stringLength2"/>
    </xs:complexType>
    <!-- Годишен отчет за образувани производствени или опасни отпадъци (Приложение 9) – Таблица „Предаден отпадък“ -->
    <xs:complexType name="r_yr_generated_waste_handType">
        <!-- Тип получател -->
        <xs:attribute name="type_receiver_code"
                      type="cm:PersonType"
                      use="required"/>
        <!-- Име на получателя -->
        <xs:attribute name="receiver_name"
                      type="cm:stringLength500"
                      use="required"/>
        <!-- ЕИК -->
        <xs:attribute name="receiver_pin_name"
                      type="cm:stringLength500"/>
        <!-- Основание за притежание -->
        <xs:attribute name="doc_num_grounds"
                      type="cm:stringLength500"/>
        <!-- Количество предаден отпадък, тон -->
        <xs:attribute name="amount_ton_handed_over"
                      type="cm:amountDeciGramNonNegative"
                      use="required"/>
    </xs:complexType>
    <!-- Годишен отчет за събиране и транспортиране на производствени и/или опасни отпадъци (Приложение №10) и Годишен отчет за събиране и транспортиране на отпадъци от черни и цветни метали (Приложение №17) “ -->
    <xs:complexType name="r_yr_r10Type">
        <xs:sequence minOccurs="1"
                     maxOccurs="1">
            <xs:element name="r_yr_r10_municipality"
                        minOccurs="0"
                        maxOccurs="1">
                <xs:complexType>
                    <xs:sequence minOccurs="1"
                                 maxOccurs="1">
                        <xs:element name="item"
                                    type="tns:r_yr_r10_municipalityType"
                                    minOccurs="1"
                                    maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="r_yr_r10_waste_origin"
                        minOccurs="0"
                        maxOccurs="1">
                <xs:complexType>
                    <xs:sequence minOccurs="1"
                                 maxOccurs="1">
                        <xs:element name="item"
                                    type="tns:r_yr_r10_waste_originType"
                                    minOccurs="1"
                                    maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="r_yr_r10_waste_out"
                        minOccurs="0"
                        maxOccurs="1">
                <xs:complexType>
                    <xs:sequence minOccurs="1"
                                 maxOccurs="1">
                        <xs:element name="item"
                                    type="tns:r_yr_r10_waste_outType"
                                    minOccurs="1"
                                    maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        <!-- Номер на площадка -->
        <xs:attribute name="stagenum"
                      type="cm:stagenumType"
                      use="required"/>
        <!-- Дали записа е за Приложение 17 -->
        <xs:attribute name="is_bc_metal"
                      type="cm:boolType"
                      use="required"/>
        <!-- Други бележки -->
        <xs:attribute name="other_notes"
                      type="cm:stringLength1024"/>
    </xs:complexType>
    <!-- Годишен отчет за годишен отчет за събиране и транспортиране (Приложение №10) и Годишен отчет за събиране и транспортиране на отпадъци от черни и цветни метали (Приложение №17) – Таблица „Произход на отпадъците - Общини“ -->
    <xs:complexType name="r_yr_r10_municipalityType">
        <!-- Община -->
        <xs:attribute name="municipality"
                      type="cm:stringLength512"
                      use="required"/>
        <!-- ЕИК -->
        <xs:attribute name="EIK"
                      type="cm:stringLength13"
                      use="required"/>
        <!-- Код на отпадъка -->
        <xs:attribute name="ewc"
                      type="ewc:ewcCodeType"
                      use="required"/>
        <!-- Описание на отпадъка -->
        <xs:attribute name="description"
                      type="cm:stringLength1024"/>
        <!-- Произход -->
        <xs:attribute name="origin_code"
                      type="cm:ReasonOriginDecType"
                      use="required"/>
        <!-- Количество, тон -->
        <xs:attribute name="amount_ton"
                      type="cm:amountDeciGramNonNegative"
                      use="required"/>
    </xs:complexType>
