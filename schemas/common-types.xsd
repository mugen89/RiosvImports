<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:tns="http://niso.tlogica.com/common-types.xsd"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://niso.tlogica.com/common-types.xsd"
           elementFormDefault="qualified">
    <xs:simpleType name="ImportType">
        <xs:restriction base="xs:string">
            <!--            <xs:enumeration value="APPEND">-->
            <!--                <xs:annotation>-->
            <!--                    <xs:documentation>С добавяне</xs:documentation>-->
            <!--                </xs:annotation>-->
            <!--            </xs:enumeration>-->
            <!-- извън бита -->
            <xs:enumeration value="REPLACE">
                <xs:annotation>
                    <xs:documentation>С заместване</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="depotCeils">
        <xs:annotation>
            <!-- N_B_CELL_TYPE -->
            <xs:documentation>Категории (тип) клетки</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="О">
                <xs:annotation>
                    <xs:documentation>Клетка опасни</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Н">
                <xs:annotation>
                    <xs:documentation>Клетка не-опасни</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="И">
                <xs:annotation>
                    <xs:documentation>Клетка инертни</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="baselConvention">
        <xs:annotation>
            <!-- N_BASEL_CONVETION -->
            <xs:documentation>Базелска конвенция</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Y 1">
                <xs:annotation>
                    <xs:documentation>Клинични отпадъци от лечебната дейност в болници, медицински центрове и клиники
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 2">
                <xs:annotation>
                    <xs:documentation>Отпадъци от производството и приготвянето на фармацевтични продукти
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 3">
                <xs:annotation>
                    <xs:documentation>Отпадъчни фармацевтични, лекарствени и медицински средства</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 4">
                <xs:annotation>
                    <xs:documentation>Отпадъци от производството, получаването и употребата на биоциди и
                        фитофармацевтични препарати
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 5">
                <xs:annotation>
                    <xs:documentation>Отпадъци от производството, получаването и употребата на консерванти за
                        дървесина
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 6">
                <xs:annotation>
                    <xs:documentation>Отпадъци от производството, получаването и употребата на органични разтворители
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 7">
                <xs:annotation>
                    <xs:documentation>Отпадъци от термична обработка и темпериращи операции, съдържащи цианиди
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 8">
                <xs:annotation>
                    <xs:documentation>Отпадъчни минерални масла, неподходящи за първоначалното им предназначение
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 9">
                <xs:annotation>
                    <xs:documentation>Отпадъчни водомаслени, водовъглеводородни смеси и емулсии</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 10">
                <xs:annotation>
                    <xs:documentation>Отпадъчни вещества и продукти, съдържащи или замърсени с полихлорирани бифенили
                        (ПХБ) и/или полихлорирани терфенили (ПХТ) или полибромирани бифенили (ПББ), или техните примеси
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 11">
                <xs:annotation>
                    <xs:documentation>Отпадъчни смолисти остатъци от рафиниране, дестилация или всякаква пиролитична
                        обработка
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 12">
                <xs:annotation>
                    <xs:documentation>Отпадъци от производството, получаването и употребата на мастила, багрила,
                        пигменти, бои, лакове и политури
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 13">
                <xs:annotation>
                    <xs:documentation>Отпадъци от производството, получаването и употребата на синтетични смоли, латекс,
                        пластификатори, лепила/свързващи материали
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 14">
                <xs:annotation>
                    <xs:documentation>Отпадни химически вещества, произтичащи от изследователска и развойна дейност и
                        обучение, които не са определени и/или са нови и чието въздействие върху човека и/или околната
                        среда е неизвестно
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 15">
                <xs:annotation>
                    <xs:documentation>Отпадъци с експлозивен характер, непопадащи под друго законодателство
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 16">
                <xs:annotation>
                    <xs:documentation>Отпадъци от производството, получаването и употребата на фотографски химикали и
                        материали за обработка на фотоматериали
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 17">
                <xs:annotation>
                    <xs:documentation>Отпадъци от повърхностна обработка на метали и пластмаси</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 18">
                <xs:annotation>
                    <xs:documentation>Остатъци от обезвреждане на промишлени отпадъци</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 19">
                <xs:annotation>
                    <xs:documentation>Метални карбонили</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 20">
                <xs:annotation>
                    <xs:documentation>Берилий: съединения на берилия</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 21">
                <xs:annotation>
                    <xs:documentation>Съединения на шествалентен хром</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 22">
                <xs:annotation>
                    <xs:documentation>Съединения на медта</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 23">
                <xs:annotation>
                    <xs:documentation>Съединения на цинка</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 24">
                <xs:annotation>
                    <xs:documentation>Арсен: съединения на арсен</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 25">
                <xs:annotation>
                    <xs:documentation>Селен: съединения на селен</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 26">
                <xs:annotation>
                    <xs:documentation>Кадмий: съединения на кадмия</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 27">
                <xs:annotation>
                    <xs:documentation>Антимон; съединения на антимона</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 28">
                <xs:annotation>
                    <xs:documentation>Телур: съединения на телура</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 29">
                <xs:annotation>
                    <xs:documentation>Живак: съединения на живака</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 30">
                <xs:annotation>
                    <xs:documentation>Талий: съединения на талия</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 31">
                <xs:annotation>
                    <xs:documentation>Олово: съединения на оловото</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 32">
                <xs:annotation>
                    <xs:documentation>Неорганични съединения на флуорина, с изключение на калциевия флуорид
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 33">
                <xs:annotation>
                    <xs:documentation>Неорганични цианиди</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 34">
                <xs:annotation>
                    <xs:documentation>Киселинни разтвори или киселини в твърдо състояние</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 35">
                <xs:annotation>
                    <xs:documentation>Основни съединения или твърди основи</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 36">
                <xs:annotation>
                    <xs:documentation>Азбест (прах и влакна)</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 37">
                <xs:annotation>
                    <xs:documentation>Органични съединения на фосфора</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 38">
                <xs:annotation>
                    <xs:documentation>Органични цианиди</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 39">
                <xs:annotation>
                    <xs:documentation>Феноли: фенолни съединения, включително хлорофеноли</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 40">
                <xs:annotation>
                    <xs:documentation>Етери</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 41">
                <xs:annotation>
                    <xs:documentation>Халогенизирани органични разтворители</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 42">
                <xs:annotation>
                    <xs:documentation>Органични разтворители, с изключение на халогенизираните разтворители
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 43">
                <xs:annotation>
                    <xs:documentation>Всякакви материали от типа на полихлорирания дибензофуран</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 44">
                <xs:annotation>
                    <xs:documentation>Всякакви материали от типа на полихлорирания дибензопидиоксин</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 45">
                <xs:annotation>
                    <xs:documentation>Органохалогенни съединения, с изключение на веществата, упоменати в това
                        приложение (например У 39, У 41, У 42, У 43, У 44)
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 46">
                <xs:annotation>
                    <xs:documentation>Битови отпадъци</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Y 47">
                <xs:annotation>
                    <xs:documentation>Остатъци, произхождащи от изгарянето на битови отпадъци</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="baselConventionCode">
        <xs:annotation>
            <!-- n_basel_convetion_code -->
            <xs:documentation>Базелска конвенция - кодове</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="A3060">
                <xs:annotation>
                    <xs:documentation>Отпадъци от нитроцелулоза</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3070">
                <xs:annotation>
                    <xs:documentation>Отпадъци от феноли, фенолни съединения, включително хлорфенол под формата на
                        течност или утайка
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3080">
                <xs:annotation>
                    <xs:documentation>Други отпадъци, неупоменати в списък Б</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3090">
                <xs:annotation>
                    <xs:documentation>Отпадъци от прах, пепел, утайки и брашно от обработени кожи, когато съдържат
                        съединения на шест-валентен хром или биоциди (виж позиция В3100)
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3100">
                <xs:annotation>
                    <xs:documentation>Изрезки и други отпадъци от обработена кожа, или от смесена кожа, негодни за
                        производството на кожени изделия, съдържащи съединения на шест-валентен хром или биоциди (виж
                        позиция В3090)
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3110">
                <xs:annotation>
                    <xs:documentation>Отпадъци от кожаро-кожухарството, съдържащи съединения на шест-валентен хром или
                        биоциди или инфекциозни субстанции (виж позиция В3110)
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3120">
                <xs:annotation>
                    <xs:documentation>Фини частици от шредиране</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3130">
                <xs:annotation>
                    <xs:documentation>Отпадъци от органични фосфорни съединения</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3140">
                <xs:annotation>
                    <xs:documentation>Отпадъци от нехалогенирани органични разтворители, с изключение на
                        тези,специфицирани в списък Б
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3150">
                <xs:annotation>
                    <xs:documentation>Отпадъци от халогенирани органични разтворители</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3160">
                <xs:annotation>
                    <xs:documentation>Отпадъчни халогенирани и нехалогенирани безводни дестилатни остатъци, произхождащи
                        от операциите по възстановяване на органичните разтворители
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3170">
                <xs:annotation>
                    <xs:documentation>Отпадъци от производството на алифатни халогенирани въглеводороди (като хлорметан,
                        дихлоретан, винил хлорид, винилиденхлорид, алилхлорид и епихлорхидрин)
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3190">
                <xs:annotation>
                    <xs:documentation>Отпадъчни катранени остатъци (с изключение на асфалтови цименти) произхождащи от
                        рафиниране, дестилация и всякакви други пиролизни обработки на органични материали
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A3200">
                <xs:annotation>
                    <xs:documentation>Битуминозни материали (асфалтови отпадъци) от пътно-строителни дейности и
                        поддръжка, съдържащи катран (виж позиция B2130)
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4010">
                <xs:annotation>
                    <xs:documentation>Отпадъци от производството, приготвянето и употребата на фармацевтични продукти, с
                        изключение на тези, специфицирани в списък Б
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4020">
                <xs:annotation>
                    <xs:documentation>Клинични и съпътстващи отпадъци; това са отпадъци, получавани от лекарската,
                        зъболекарската, ветеринарната или подобни практики, и отпадъци получени в болници или други
                        съоръжения по време на диагностициране или лечение на пациентите или научноизследователски
                        проекти
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4030">
                <xs:annotation>
                    <xs:documentation>Отпадъци от производството, приготвянето и употребата на биоциди и препарати за
                        фитосанитарна опазване, включително отпадъчни пестициди и хербициди, които не са специфицирани,
                        с изтекъл срок на годност (2 ) или негодни за употребата, за която са предназначени
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4040">
                <xs:annotation>
                    <xs:documentation>Отпадъци от производството, приготвянето и употребата на дървесни консерванти
                        (3)
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4050">
                <xs:annotation>
                    <xs:documentation>Отпадъци, които съдържат, състоят се от или са замърсени с едно от следните:
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4060">
                <xs:annotation>
                    <xs:documentation>Отпадъчни смеси от масла и вода, въглеводороди и вода, емулсии</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4070">
                <xs:annotation>
                    <xs:documentation>Отпадъци от производството, приготвянето и употребата на мастила, бои, пигменти,
                        оцветители, лакове и политури, с изключение на такива, специфицирани в списък Б (виж позиция
                        B4010)
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4080">
                <xs:annotation>
                    <xs:documentation>Отпадъци с експлозивни свойства (с изключение на тези, специфицирани в списък Б)
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4090">
                <xs:annotation>
                    <xs:documentation>Отпадъчни разтвори на киселини и основи, различни от посочените в съответната
                        позиция в списък Б (виж позиция B2120)
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4100">
                <xs:annotation>
                    <xs:documentation>Отпадъци от прибори за контрол на изходящи промишлени газове, с изключение на
                        тези, специфицирани в списък Б
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4110 ">
                <xs:annotation>
                    <xs:documentation>Отпадъци, които съдържат, състоят се от или са замърсени с някои от следните:
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4120">
                <xs:annotation>
                    <xs:documentation>Отпадъци, които съдържат, състоят се от или са замърсени с пероксиди
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4130">
                <xs:annotation>
                    <xs:documentation>Отпадъци от опаковки и контейнери, съдържащи вещества от приложение I в такива
                        концентрации, че да проявяват опасните свойства от приложение III
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4140">
                <xs:annotation>
                    <xs:documentation>Отпадъци, състоящи се от или съдържащи химикали които не са специфицирани или с
                        изтекъл срок на годност (1), отговарящи на категориите към приложение I и проявяващи опасните
                        свойства от приложение III
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4150">
                <xs:annotation>
                    <xs:documentation>Отпадъци от химически вещества, получени от развойни или преподавателски дейности,
                        които не са идентифицирани и/или са нови и чиито въздействия върху здравето на човека и/или
                        околната среда са непознати
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="A4160">
                <xs:annotation>
                    <xs:documentation>Отработен активен въглен, невключен в списък Б (виж позиция B2060)
                    </xs:documentation>
                </xs:annotation>
